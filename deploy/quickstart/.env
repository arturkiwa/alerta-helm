# Alerta Next – quick-start settings. Everything you may want to change is here.

# Images (Docker Hub). Keep backend and frontend on the same version.
BACKEND_IMAGE=docker.io/arturkiwa/alerta-next-backend:0.13.0
FRONTEND_IMAGE=docker.io/arturkiwa/alerta-next-frontend:0.13.0

# Web UI on this port of your machine: http://localhost:8080
ALERTA_PORT=8080

# Database. Default: the bundled PostgreSQL ("db" service). For your own PostgreSQL set DB_URL/DB_USER/DB_PASSWORD
# to it and start without the bundled one: docker compose up -d --no-deps frontend backend (docs/deployment).
DB_URL=jdbc:postgresql://db:5432/alerta
DB_USER=alerta
# Change it before the first start; the bundled PostgreSQL takes it only when it creates its data
# (to change it later: docker compose down -v – wipes all data).
DB_PASSWORD=quickstart-change-me

# Optional parts. "monitoring" = a Prometheus with demo alerts + an Alertmanager sending them to Alerta Next.
# Remove "monitoring" (leave COMPOSE_PROFILES empty) to run Alerta Next alone.
COMPOSE_PROFILES=monitoring

# Silences from the console go to this Alertmanager API. Empty = no "Silence" button (set it empty when the
# "monitoring" profile is off, or point it to your own Alertmanager).
ALERTMANAGER_URL=http://alertmanager:9093
